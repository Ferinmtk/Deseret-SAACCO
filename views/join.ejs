<%- include('partials/header', { pageTitle: 'Join Us' }) %>

<%- include('partials/page-hero', { photo: 'join', focus: 'center 45%', heading: 'Join Deseret Sacco', lead: 'Become part of a trusted savings family for Church employees in Kenya.' }) %>

<!-- WHY JOIN: one short set of reasons (was split across two repeating sections) -->
<section class="section section-alt">
  <div class="container">
    <div class="text-center"><h2>Why join?</h2><p class="intro">Built by and for the Church workforce in Kenya.</p></div>
    <div class="row g-3">
      <% for (const [icon, title, text] of [
        ['heart', 'Faith-aligned finance', 'We operate by gospel principles of stewardship and service.'],
        ['cash-coin', 'Affordable loans', 'Fair rates, and up to 6 years to repay development loans.'],
        ['lightning-charge', 'Quick processing', 'Apply and follow your loan online; emergency loans are fast-tracked.'],
        ['people', 'Grow together', 'Your savings earn interest and dividends, and you vote at the AGM.'],
      ]) { %>
        <div class="col-6 col-lg-3 fade-in"><div class="simple-card"><i class="bi bi-<%= icon %>"></i><h3 class="h6 fw-bold mt-2 mb-1"><%= title %></h3><p class="small"><%= text %></p></div></div>
      <% } %>
    </div>
  </div>
</section>

<!-- MEMBERSHIP INFO -->
<section class="py-5">
  <div class="container">
    <h2 class="fw-bold text-center mb-4">Membership</h2>
    <p class="text-center">Deseret Sacco draws its membership from employees of the Church of Jesus Christ of Latter-day Saints in Kenya, members of the Church, their spouses and children, Corporate Institutions, and Groups/Chamas.</p>
    
    <div class="row mt-4">
      <div class="col-md-6" data-aos="fade-right">
        <h4 class="fw-bold">How to Join</h4>
        <ul>
          <li>Introduction letter from the institution (employer)</li>
          <li>Application form — <a href="/join/apply">apply online</a> or collect one from the office — with a copy of your ID or passport</li>
          <li>If you were in another SACCO: a letter showing you owe it nothing</li>
          <li>Registration fee: <strong>Kshs. 1,000</strong> (one-time, non-refundable)</li>
          <li>Share Capital: <strong>Kshs. 6,500</strong> (non-refundable, earns dividends, transferable upon withdrawal)</li>
          <li>Minimum monthly deposit contribution: <strong>Kshs. 1,000</strong></li>
        </ul>
      </div>
      <div class="col-md-6" data-aos="fade-left">
        <h4 class="fw-bold">Corporate Membership</h4>
        <ul>
          <li>Registration fee: <strong>Kshs. 5,000</strong> (non-refundable)</li>
          <li>Share capital: <strong>Kshs. 30,000</strong> (non-refundable but transferable)</li>
          <li>Introduction letter or minutes with resolution to open account</li>
          <li>Recommendation letter from Bishop/congregation head (where applicable)</li>
          <li>Duly filled form with authorized signatories’ details</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- SECURITIES -->
<section class="py-5">
  <div class="container">
    <h2 class="fw-bold text-center mb-4">Securities/Collateral for Institution Loans</h2>
    <div class="row justify-content-center">
      <div class="col-md-8">
        <ul>
          <li>Institution savings in Sacco</li>
          <li>Share certificates at Nairobi Stock Exchange or Government Bonds</li>
          <li>Vehicle logbooks</li>
          <li>Land Title deeds</li>
          <li>Fixed deposits guaranteed by the Institution</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- PAYING -->
<section class="section section-alt">
  <div class="container">
    <div class="text-center">
      <h2>Paying your fees and contributions</h2>
      <p class="intro">Church employees pay through payroll deductions. Everyone else can use M-Pesa or a standing order from their bank.</p>
    </div>
    <div class="row g-4">
      <div class="col-md-6 fade-in">
        <div class="simple-card">
          <i class="bi bi-phone"></i>
          <h3 class="h5">M-Pesa</h3>
          <ul>
            <li>Paybill <span class="fact"><%= S.SACCO.paybill %></span></li>
            <li>Account <span class="fact"><%= S.SACCO.account %></span></li>
            <li>Then send the M-Pesa message to <span class="fact"><%= S.SACCO.smsNumber %></span>, or submit the code in the member portal.</li>
          </ul>
        </div>
      </div>
      <div class="col-md-6 fade-in">
        <div class="simple-card">
          <i class="bi bi-bank"></i>
          <h3 class="h5">Bank or standing order</h3>
          <ul>
            <li><%= S.SACCO.bank %>, <%= S.SACCO.branch %></li>
            <li>Account <span class="fact"><%= S.SACCO.account %></span> · SWIFT <%= S.SACCO.swift %></li>
            <li>Account name: <%= S.SACCO.name %></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="text-center py-5 bg-success text-white">
  <div class="container">
    <h2 class="fw-bold mb-2">Ready to Become a Member?</h2>
    <p class="mb-4" style="color: #cdd6df;">Apply online in about 10 minutes, then bring your ID copy and employer’s letter to the office.</p>
    <div class="d-flex flex-wrap gap-2 justify-content-center">
      <a href="/join/apply" class="btn btn-light btn-lg px-4" style="color: var(--brand);">Apply online</a>
      <a href="/contact" class="btn btn-outline-light btn-lg px-4">Contact the office</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
