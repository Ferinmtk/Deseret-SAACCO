<%- include('../partials/app-top', { area: 'portal' }) %>
<div class="row g-3">
  <div class="col-lg-6">
    <div class="card mb-3">
      <div class="card-header"><i class="bi bi-person-vcard"></i> Membership</div>
      <div class="card-body">
        <dl class="row mb-0 small">
          <dt class="col-5">Member number</dt><dd class="col-7"><%= member.member_no %></dd>
          <dt class="col-5">Name</dt><dd class="col-7"><%= member.first_name %> <%= member.last_name %></dd>
          <dt class="col-5">ID number</dt><dd class="col-7"><%= member.id_number %></dd>
          <dt class="col-5">KRA PIN</dt><dd class="col-7"><%= member.kra_pin %></dd>
          <dt class="col-5">Date of birth</dt><dd class="col-7"><%= S.fmtDate(member.date_of_birth) %></dd>
          <dt class="col-5">Employer</dt><dd class="col-7"><%= member.employer || 'Not employed by the Church' %></dd>
          <% if (member.department) { %><dt class="col-5">Department</dt><dd class="col-7"><%= member.department %> · <%= member.designation %></dd><% } %>
          <dt class="col-5">Terms of service</dt><dd class="col-7 text-capitalize"><%= member.terms %><%= member.contract_end ? ' until ' + S.fmtDate(member.contract_end) : '' %></dd>
          <dt class="col-5">Payroll number</dt><dd class="col-7"><%= member.payroll_no || '—' %></dd>
          <dt class="col-5">Home ward / branch</dt><dd class="col-7"><%= member.ward || '—' %></dd>
          <dt class="col-5">Bank</dt><dd class="col-7"><%= member.bank_name %> · <%= member.bank_branch %> · <%= member.bank_account %></dd>
          <dt class="col-5">Member since</dt><dd class="col-7"><%= S.fmtDate(member.joined_at) %></dd>
        </dl>
        <p class="small text-muted mt-2 mb-0">To change your name, ID, employer or bank, visit the office with your documents.</p>
      </div>
    </div>
    <div class="card mb-3 editable <%= edit === 'contact' ? 'editing' : '' %>" id="contact">
      <div class="card-header"><i class="bi bi-telephone"></i> Contact details
        <button type="button" class="btn btn-sm btn-light ms-auto show-view" data-edit><i class="bi bi-pencil"></i> Edit</button></div>
      <div class="card-body view">
        <dl class="row mb-0 small">
          <dt class="col-5">Mobile (M-Pesa)</dt><dd class="col-7"><%= member.phone %></dd>
          <dt class="col-5">Email</dt><dd class="col-7"><%= member.email || 'Not given' %></dd>
        </dl>
      </div>
      <form class="card-body edit" method="POST" action="/portal/profile/contact">
        <div class="row g-2">
          <div class="col-sm-6"><label class="form-label" for="c-phone">Mobile (M-Pesa)</label><input class="form-control" id="c-phone" name="phone" type="tel" value="<%= member.phone %>" required></div>
          <div class="col-sm-6"><label class="form-label" for="c-email">Email</label><input class="form-control" id="c-email" type="email" name="email" value="<%= member.email || '' %>"></div>
          <div class="col-12 d-flex gap-2"><button class="btn btn-primary btn-sm">Save changes</button><button type="button" class="btn btn-light btn-sm" data-cancel>Cancel</button></div>
        </div>
      </form>
    </div>
    <div class="card editable" id="password">
      <div class="card-header"><i class="bi bi-key"></i> Password
        <button type="button" class="btn btn-sm btn-light ms-auto show-view" data-edit><i class="bi bi-pencil"></i> Change</button></div>
      <div class="card-body view small text-muted">Use at least 8 characters and don’t share it with anyone, including SACCO staff.</div>
      <form class="card-body row g-2 edit" method="POST" action="/portal/profile/password">
        <div class="col-12"><input class="form-control" type="password" name="current" placeholder="Current password" autocomplete="current-password" required></div>
        <div class="col-sm-6"><input class="form-control" type="password" name="next" placeholder="New password (8+ characters)" autocomplete="new-password" required></div>
        <div class="col-sm-6"><input class="form-control" type="password" name="confirm" placeholder="Repeat new password" autocomplete="new-password" required></div>
        <div class="col-12 d-flex gap-2"><button class="btn btn-primary btn-sm">Change password</button><button type="button" class="btn btn-light btn-sm" data-cancel>Cancel</button></div>
      </form>
    </div>
  </div>

  <div class="col-lg-6">
<% const pending = nomineeRequest && nomineeRequest.status === 'pending' ? nomineeRequest.d : null;
   const draft = pending ? pending.nominees : (nominees.length ? nominees : [{}]); %>
    <div class="card mb-3 editable <%= edit === 'nominees' ? 'editing' : '' %>" id="nominees">
      <div class="card-header"><i class="bi bi-heart"></i> Nominees
        <button type="button" class="btn btn-sm btn-light ms-auto show-view" data-edit><i class="bi bi-pencil"></i> <%= pending ? 'Edit request' : 'Change nominees' %></button></div>
      <div class="card-body view">
        <p class="small text-muted mb-2">Who receives your savings if you pass away.</p>
        <% if (nominees.length) { %>
          <% for (const n of nominees) { %>
            <div class="d-flex justify-content-between border-bottom py-2 small"><span><strong><%= n.name %></strong> · <%= n.relationship %><%= n.phone ? ' · ' + n.phone : '' %></span><span class="num fw-semibold"><%= n.share_pct %>%</span></div>
          <% } %>
        <% } else { %>
          <div class="alert alert-warning small mb-0"><i class="bi bi-exclamation-triangle"></i> You have no nominee on file. Without one, your family may need court papers to claim your savings.</div>
        <% } %>

        <% if (pending) { %>
          <div class="nominee-pending mt-3">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div><span class="pill pill-warn">Waiting for the office</span>
                <div class="small mt-2">You asked on <%= S.fmtDate(nomineeRequest.created_at) %> to change your nominees to:</div></div>
              <form method="POST" action="/portal/profile/nominees/cancel"><button class="btn btn-sm btn-link text-danger p-0">Cancel change</button></form>
            </div>
            <ul class="small mb-2 mt-1"><% for (const n of pending.nominees) { %><li><%= n.name %> (<%= n.relationship %>) · <%= n.share_pct %>%</li><% } %></ul>
            <div class="small text-muted">Next: the office confirms with your witnesses, <%= pending.witnesses.map(w => w.name + ' (' + w.member_no + ')').join(' and ') %>. Your current nominees above stay on file until then.</div>
          </div>
        <% } else if (nomineeRequest && nomineeRequest.status !== 'pending') { %>
          <div class="small text-muted mt-2"><i class="bi bi-<%= nomineeRequest.status === 'approved' ? 'check-circle text-success' : 'x-circle text-danger' %>"></i>
            Your last change (<%= S.fmtDate(nomineeRequest.created_at) %>) was <%= nomineeRequest.status === 'approved' ? 'confirmed by the office' : 'not approved — please contact the office' %>.</div>
        <% } %>
      </div>

      <form class="card-body edit" method="POST" action="/portal/profile/nominees">
        <div class="howto small mb-3">
          <strong>How changing nominees works (By-law 12):</strong>
          <ol class="mb-0 ps-3 mt-1"><li>Enter your nominees and two SACCO members as witnesses.</li><li>The office confirms the change with your witnesses.</li><li>Your new nominees replace the old ones. Until then, your current nominees stay on file.</li></ol>
        </div>
        <div id="nomRows">
          <% for (const n of draft) { %>
            <div class="row g-2 mb-3 p-2 rounded border nom-row">
              <% for (const [name, label, col, type, extra] of [['name', 'Full name', 'col-12 col-sm-5', 'text', ''], ['relationship', 'Relationship', 'col-7 col-sm-4', 'text', ''],
                   ['share_pct', 'Share %', 'col-5 col-sm-3', 'number', 'min="1" max="100"'], ['id_number', 'ID / passport', 'col-6 col-sm-4', 'text', ''],
                   ['phone', 'Phone', 'col-6 col-sm-4', 'tel', ''], ['address', 'Address', 'col-12 col-sm-4', 'text', '']]) { %>
                <div class="<%= col %>"><label class="nom-label"><%= label %></label><input class="form-control form-control-sm" type="<%= type %>" name="<%= name %>" <%- extra %> value="<%= n[name] || '' %>"></div>
              <% } %>
            </div>
          <% } %>
        </div>
        <button type="button" class="btn btn-sm btn-light mb-3" id="addNominee"><i class="bi bi-plus"></i> Add another nominee</button>
        <div class="row g-2 mb-1">
          <div class="col-sm-6"><label class="nom-label" for="w1">Witness 1 · member number</label><input class="form-control form-control-sm text-uppercase" id="w1" name="witness1" placeholder="e.g. DS0002" value="<%= pending ? pending.witnesses[0].member_no : '' %>" required></div>
          <div class="col-sm-6"><label class="nom-label" for="w2">Witness 2 · member number</label><input class="form-control form-control-sm text-uppercase" id="w2" name="witness2" placeholder="e.g. DS0003" value="<%= pending ? pending.witnesses[1].member_no : '' %>" required></div>
        </div>
        <p class="small text-muted">Shares must add up to 100%. Total now: <strong id="shareTotal">0%</strong></p>
        <div class="d-flex gap-2"><button class="btn btn-primary btn-sm">Send for confirmation</button><button type="button" class="btn btn-light btn-sm" data-cancel>Cancel</button></div>
      </form>
    </div>

    <form class="card mb-3" id="deductions" method="POST" action="/portal/deductions">
      <div class="card-header"><i class="bi bi-arrow-left-right"></i> Change my monthly deductions</div>
      <div class="card-body">
        <p class="small text-muted">Online version of the “Authority to make deductions (variations)” form.</p>
        <div class="row g-2 small align-items-center mb-2 deduct-grid">
          <div class="col-12 col-sm-4 fw-semibold">Shares / deposits</div>
          <div class="col-6 col-sm-4"><input class="form-control form-control-sm" type="number" min="0" name="shares_from" placeholder="From KES"></div>
          <div class="col-6 col-sm-4"><input class="form-control form-control-sm" type="number" min="0" name="shares_to" placeholder="To KES"></div>
          <div class="col-12 col-sm-4 fw-semibold">Loan repayment</div>
          <div class="col-6 col-sm-4"><input class="form-control form-control-sm" type="number" min="0" name="loan_from" placeholder="From KES"></div>
          <div class="col-6 col-sm-4"><input class="form-control form-control-sm" type="number" min="0" name="loan_to" placeholder="To KES"></div>
          <div class="col-12 col-sm-4 fw-semibold">With effect from</div>
          <div class="col-12 col-sm-8"><input class="form-control form-control-sm" type="month" name="effective" required></div>
        </div>
        <button class="btn btn-sm btn-primary">Send request</button>
        <% for (const r of requests) { const d = JSON.parse(r.details); %>
          <div class="d-flex justify-content-between small border-top mt-2 pt-2">
            <span><%= S.fmtDate(r.created_at) %> · <%= d.shares_to ? 'Shares → ' + S.fmtKes(d.shares_to) : '' %> <%= d.loan_to ? 'Loan → ' + S.fmtKes(d.loan_to) : '' %></span>
            <span class="pill pill-<%= { pending: 'warn', approved: 'ok', rejected: 'danger' }[r.status] %>"><%= r.status === 'pending' ? 'With the office' : r.status %></span>
          </div>
        <% } %>
      </div>
    </form>

    <div class="card">
      <div class="card-header"><i class="bi bi-box-arrow-right"></i> Leaving the SACCO</div>
      <div class="card-body small">
        <% if (member.status === 'exiting') { %>
          <div class="alert alert-info mb-2"><strong>Notice received <%= S.fmtDate(member.exit_notice_at) %>.</strong> Your notice period ends <strong><%= refundDue %></strong>; your deposits, interest and dividends (less anything you owe) are refunded after that.</div>
          <p class="mb-0 text-muted">Your share capital can be transferred to another member. If you guarantee any loans, the borrowers must find replacement guarantors.</p>
        <% } else { %>
          <p>You can withdraw by giving <strong><%= noticeDays %> days’</strong> written notice (By-law 16). Your own loans must be repaid and any loans you guarantee must have new guarantors first. Share capital isn’t refunded but can be transferred to another member (By-law 23). Rejoining later carries a KES 5,000 fine.</p>
          <form method="POST" action="/portal/profile/exit" onsubmit="return confirm('Give notice to leave Deseret SACCO? This starts the <%= noticeDays %>-day refund period.')">
            <button class="btn btn-sm btn-outline-danger">Give notice to leave</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>
<script>
  // Sections show a summary until the member chooses to edit them.
  document.querySelectorAll('.editable').forEach(card => {
    card.querySelector('[data-edit]')?.addEventListener('click', () => { card.classList.add('editing'); card.querySelector('.edit input')?.focus(); });
    card.querySelector('[data-cancel]')?.addEventListener('click', () => card.classList.remove('editing'));
  });
  const rows = document.getElementById('nomRows');
  const total = () => { document.getElementById('shareTotal').textContent = [...rows.querySelectorAll('input[name="share_pct"]')].reduce((s, i) => s + (+i.value || 0), 0) + '%'; };
  rows.addEventListener('input', total); total();
  document.getElementById('addNominee').addEventListener('click', () => {
    const r = rows.querySelector('.nom-row').cloneNode(true); r.querySelectorAll('input').forEach(i => i.value = ''); rows.appendChild(r); total();
  });
</script>
<%- include('../partials/app-bottom') %>
