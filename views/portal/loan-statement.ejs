<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Loan statement · <%= loan.product_name %> #<%= loan.id %> · <%= member.member_no %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <%- include("../partials/icons") %>
  <link rel="stylesheet" href="/css/app.css">
  <style>body{background:#fff;font-size:13px} .sheet{max-width:820px;margin:2rem auto;padding:0 1rem} h2{font-size:1rem;margin:1.5rem 0 .5rem}</style>
</head>
<body class="app">
<% const k = S.fmtKes; const st = loan.state; %>
<div class="sheet">
  <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
    <div class="d-flex gap-2 align-items-center"><img src="/img/brand/logo-mark.svg" width="53" height="44" alt="">
      <div><strong class="fs-5">Deseret SACCO Society Limited</strong><br><span class="text-muted"><%= S.SACCO.office %> · <%= S.SACCO.postal %> · <%= S.SACCO.phone %></span></div></div>
    <div class="d-flex gap-2 no-print">
      <a class="btn btn-outline-primary btn-sm" href="?format=csv">Excel</a>
      <button class="btn btn-primary btn-sm" onclick="print()">Print / Save as PDF</button>
    </div>
  </div>

  <div class="row mb-3">
    <div class="col"><div class="small-caps">Member</div><strong><%= member.first_name %> <%= member.last_name %></strong><br><%= member.member_no %> · ID <%= member.id_number %></div>
    <div class="col text-end"><div class="small-caps">Loan statement</div><strong><%= loan.product_name %> #<%= loan.id %></strong><br>As at <%= S.fmtDate(S.today()) %></div>
  </div>

  <table class="table table-sm">
    <tbody>
      <tr><th>Borrowed</th><td class="num"><%= k(loan.principal) %></td><th>Paid out</th><td><%= S.fmtDate(loan.disbursed_at) %></td></tr>
      <tr><th>Interest</th><td><%= (loan.rate_monthly * 100).toFixed(1) %>% a month, <%= loan.method %> balance</td><th>Period</th><td><%= loan.months %> months</td></tr>
      <tr><th>Monthly installment</th><td class="num"><%= k(loan.installment) %></td><th>Total to repay</th><td class="num"><%= k(loan.total_payable) %></td></tr>
      <tr><th>Repaid so far</th><td class="num"><%= k(st.paid) %></td><th>Status</th><td><%= loan.status === 'closed' ? 'Fully repaid' : st.arrears ? `${k(st.arrears)} overdue (${st.daysInArrears} days)` : 'Up to date' %></td></tr>
      <% if (loan.status === 'disbursed') { %><tr><th>To clear it today</th><td class="num fw-bold"><%= k(clears) %></td><td colspan="2" class="text-muted small">Principal still owed, without future interest. Confirm with the office before paying it off.</td></tr><% } %>
    </tbody>
  </table>

  <h2>Repayments</h2>
  <table class="table table-sm">
    <thead><tr><th>Date</th><th>Details</th><th class="text-end">Amount</th><th class="text-end">Left to repay</th></tr></thead>
    <tbody>
      <% for (const r of repayments) { %>
        <tr><td><%= S.fmtDate(r.created_at) %></td><td><%= r.description %></td><td class="text-end num"><%= r.amount.toLocaleString('en-KE') %></td><td class="text-end num"><%= k(Math.max(r.balance, 0)) %></td></tr>
      <% } %>
      <% if (!repayments.length) { %><tr><td colspan="4" class="text-muted">No repayments yet.</td></tr><% } %>
    </tbody>
  </table>

  <h2>Repayment schedule</h2>
  <table class="table table-sm">
    <thead><tr><th>#</th><th>Due</th><th class="text-end">Principal</th><th class="text-end">Interest</th><th class="text-end">Installment</th><th class="text-end">Balance after</th><th>Status</th></tr></thead>
    <tbody>
      <% for (const r of schedule) { %>
        <tr><td><%= r.no %></td><td><%= S.fmtDate(r.due) %></td><td class="text-end num"><%= r.principal.toLocaleString('en-KE') %></td><td class="text-end num"><%= r.interest.toLocaleString('en-KE') %></td>
          <td class="text-end num"><%= r.installment.toLocaleString('en-KE') %></td><td class="text-end num"><%= r.balance.toLocaleString('en-KE') %></td><td><%= SCHEDULE_STATUS[r.status] %></td></tr>
      <% } %>
    </tbody>
  </table>
  <p class="text-muted small mt-4">Generated <%= S.fmtDate(S.today()) %> from the member portal. Report any discrepancy to the SACCO office within 30 days.</p>
</div>
</body>
</html>
