<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Statement · <%= S.ACCOUNTS[account] %> · <%= member.member_no %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <%- include("../partials/icons") %>
  <link rel="stylesheet" href="/css/app.css">
  <style>body{background:#fff;font-size:13px} .sheet{max-width:820px;margin:2rem auto;padding:0 1rem}</style>
</head>
<body class="app">
<div class="sheet">
  <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
    <div class="d-flex gap-2 align-items-center"><img src="/img/brand/logo-mark.svg" width="53" height="44" alt="">
      <div><strong class="fs-5">Deseret SACCO Society Limited</strong><br><span class="text-muted">Church Administration Office Building, Upper Hill Road, Nairobi</span></div></div>
    <button class="btn btn-primary btn-sm no-print" onclick="print()">Print / Save as PDF</button>
  </div>
  <div class="row mb-3">
    <div class="col"><div class="small-caps">Member</div><strong><%= member.first_name %> <%= member.last_name %></strong><br><%= member.member_no %> · ID <%= member.id_number %></div>
    <div class="col text-end"><div class="small-caps">Statement</div><strong><%= S.ACCOUNTS[account] %></strong><br><%= S.fmtDate(from) %> – <%= S.fmtDate(to) %></div>
  </div>
  <table class="table table-sm">
    <thead><tr><th>Date</th><th>Details</th><th>Reference</th><th class="text-end">Amount</th><th class="text-end">Balance</th></tr></thead>
    <tbody>
      <tr><td><%= S.fmtDate(from) %></td><td colspan="3">Opening balance</td><td class="text-end num"><%= S.fmtKes(opening) %></td></tr>
      <% for (const r of rows.slice().reverse()) { %>
        <tr><td><%= S.fmtDate(r.created_at) %></td><td><%= r.description %></td><td><%= r.reference || '' %></td>
          <td class="text-end num"><%= r.amount.toLocaleString('en-KE') %></td><td class="text-end num"><%= S.fmtKes(r.balance) %></td></tr>
      <% } %>
      <tr class="fw-bold"><td><%= S.fmtDate(to) %></td><td colspan="3">Closing balance</td><td class="text-end num"><%= S.fmtKes(closing) %></td></tr>
    </tbody>
  </table>
  <p class="text-muted small mt-4">Generated <%= S.fmtDate(S.today()) %> from the member portal. Report any discrepancy to the SACCO office within 30 days.</p>
</div>
</body>
</html>
