<%- include('../partials/app-top', { area: 'portal' }) %>
<% const k = S.fmtKes; %>
<div class="row g-3 mb-3">
  <div class="col-md-4"><div class="card"><div class="stat"><div class="k">Your deposits</div><div class="v num"><%= k(capacity.deposits) %></div><div class="s">What you can pledge from</div></div></div></div>
  <div class="col-md-4"><div class="card"><div class="stat"><div class="k">Pledged for others</div><div class="v num"><%= k(capacity.exposure) %></div><div class="s">Shrinks as borrowers repay</div></div></div></div>
  <div class="col-md-4"><div class="card"><div class="stat"><div class="k">Free to guarantee</div><div class="v num pos"><%= k(capacity.free) %></div><div class="s"><%= capacity.count %> of <%= capacity.maxLoans %> loans used</div></div></div></div>
</div>

<h6 class="small-caps mb-2">Requests waiting for you</h6>
<% if (!requests.length) { %><div class="card mb-4"><div class="empty"><i class="bi bi-inbox"></i>No guarantor requests right now.</div></div><% } %>
<% for (const r of requests) { const accepted = r.cover.filter(c => c.status === 'accepted').reduce((s, c) => s + c.amount, 0); const fits = r.amount <= capacity.free; %>
  <div class="card mb-4 border-warning">
    <div class="card-header"><i class="bi bi-person-raised-hand"></i> <%= r.borrower %> asked you to guarantee <strong class="ms-1"><%= k(r.amount) %></strong><span class="ms-auto small text-muted"><%= S.fmtDate(r.requested_at) %></span></div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <div class="small-caps">The loan</div>
          <div class="fw-semibold"><%= r.product_name %> · <%= k(r.principal) %></div>
          <div class="small text-muted"><%= r.months %> months · <%= k(r.installment) %>/month<br><%= r.purpose || '' %></div>
        </div>
        <div class="col-md-4">
          <div class="small-caps">Borrower’s record</div>
          <div class="small">Member since <%= S.fmtDate(r.joined_at) %> (<%= r.member_no %>)</div>
          <div class="small"><%= r.history.closed %> loan(s) fully repaid · <%= r.history.active %> active</div>
          <div class="small"><% if (r.history.inArrears) { %><span class="neg"><i class="bi bi-exclamation-circle"></i> Currently behind by <%= r.history.worstDays %> days</span><% } else { %><span class="pos"><i class="bi bi-check-circle"></i> No arrears</span><% } %></div>
        </div>
        <div class="col-md-4">
          <div class="small-caps">What it means for you</div>
          <div class="small"><%= k(r.amount) %> of your deposits will be <strong>locked</strong> until the loan is repaid.</div>
          <div class="small">Free to guarantee after: <strong class="<%= fits ? '' : 'neg' %>"><%= k(capacity.free - r.amount) %></strong></div>
          <div class="small text-muted">Cover so far: <%= k(accepted) %> from other guarantors.</div>
        </div>
      </div>
      <div class="alert alert-light small mt-3 mb-3"><i class="bi bi-info-circle"></i> If <%= r.borrower.split(' ')[0] %> stops paying, the SACCO first uses their own deposits. Only then is the rest recovered from guarantors, in proportion to what each pledged. You’ll be alerted if a payment is missed.</div>
      <form method="POST" action="/portal/guarantees/<%= r.id %>" class="d-flex gap-2">
        <button name="decision" value="accept" class="btn btn-primary" <%= fits ? '' : 'disabled' %>><i class="bi bi-check-lg"></i> Accept and guarantee <%= k(r.amount) %></button>
        <button name="decision" value="decline" class="btn btn-outline-secondary">Decline</button>
      </form>
    </div>
  </div>
<% } %>

<h6 class="small-caps mb-2">Loans you guarantee</h6>
<div class="card mb-4">
  <div class="table-responsive"><table class="table">
    <thead><tr><th>Borrower</th><th>Loan</th><th class="text-end">You pledged</th><th class="text-end">Still at risk</th><th>Status</th></tr></thead>
    <tbody>
      <% for (const l of guaranteed) { const share = l.status === 'disbursed' ? l.state.outstanding / l.total_payable : 1; %>
        <tr>
          <td><%= l.borrower %></td><td><%= l.product_name %> · <%= k(l.principal) %></td>
          <td class="text-end num"><%= k(l.amount) %></td><td class="text-end num"><%= k(l.amount * share) %></td>
          <td><% if (l.state.arrears > 0) { %><span class="pill pill-danger"><%= l.state.daysInArrears %> days late</span><% } else if (l.status === 'disbursed') { %><span class="pill pill-ok"><%= l.state.progress %>% repaid</span><% } else { %><span class="pill pill-muted"><%= S.STATUS_LABELS[l.status] %></span><% } %></td>
        </tr>
      <% } %>
      <% if (!guaranteed.length) { %><tr><td colspan="5" class="text-muted">You aren’t guaranteeing any loans.</td></tr><% } %>
    </tbody>
  </table></div>
</div>

<% if (past.length) { %>
  <h6 class="small-caps mb-2">History</h6>
  <div class="card"><div class="table-responsive"><table class="table table-sm">
    <tbody><% for (const g of past) { %><tr><td><%= g.borrower %></td><td><%= g.product_name %></td><td class="num text-end"><%= k(g.amount) %></td>
      <td><span class="pill pill-muted"><%= g.status === 'declined' ? 'You declined' : g.loan_status === 'closed' ? 'Released — loan repaid' : 'Released — loan declined' %></span></td></tr><% } %></tbody>
  </table></div></div>
<% } %>
<%- include('../partials/app-bottom') %>
