<%- include('../partials/auth-page', {
  heading: 'Member sign in', sub: 'Use your Deseret SACCO member number.', action: '/portal/login',
  pitch: 'Your savings, loans and guarantees — all in one place.',
  points: ['See exactly where every payment went', 'Check what you can borrow before you apply', 'Accept guarantor requests with the full picture', 'Download statements any time'],
  body: `
    <label class="form-label" for="memberNo">Member number</label>
    <input class="form-control mb-3" id="memberNo" name="memberNo" placeholder="e.g. DS0001" value="${S.esc(locals.memberNo || '')}" autocomplete="username" required autofocus>
    <div class="d-flex justify-content-between"><label class="form-label" for="password">Password</label><a href="/portal/forgot-password" class="small">Forgot password?</a></div>
    <input class="form-control mb-3" type="password" id="password" name="password" autocomplete="current-password" required>`,
  foot: `
    <div class="demo-note mt-4"><strong>Demo:</strong> member <code>DS0001</code>, password <code>demo1234</code></div>
    <p class="text-center mt-4 mb-0 small text-muted">Not a member yet? <a href="/join">How to join</a> · Staff? <a href="/admin/login">Admin sign in</a></p>`
}) %>
