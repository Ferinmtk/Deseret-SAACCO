<%- include('../partials/app-top', { area: 'portal' }) %>
<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5">
    <form class="card" method="POST" action="/portal/change-password">
      <div class="card-header"><i class="bi bi-key"></i> Choose your password</div>
      <div class="card-body">
        <p class="small text-muted">For your security, replace the temporary password (your ID number) with one only you know. Use at least 8 characters.</p>
        <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
        <label class="form-label" for="next">New password</label>
        <input class="form-control mb-3" type="password" id="next" name="next" autocomplete="new-password" minlength="8" required autofocus>
        <label class="form-label" for="confirm">Repeat new password</label>
        <input class="form-control mb-3" type="password" id="confirm" name="confirm" autocomplete="new-password" minlength="8" required>
        <button class="btn btn-primary w-100">Save password</button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/app-bottom') %>
