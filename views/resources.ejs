<%- include('partials/header', { pageTitle: 'Forms & Resources' }) %>

<%- include('partials/page-hero', { photo: 'resources', focus: 'center 40%', heading: 'Forms & Resources', lead: 'The forms you need, and where to get them.' }) %>

<section class="section">
  <div class="container" style="max-width: 960px;">
    <div class="text-center">
      <h2>Forms</h2>
      <p class="intro">Every form can now be done online. Paper copies are still available from the office.</p>
    </div>
    <div class="row g-3">
      <% for (const [icon, name, text, where] of [
        ['person-plus', 'Application for membership', 'For new members. Includes your nominated next of kin. Bring a copy of your ID and your employer’s introduction letter.', 'apply'],
        ['arrow-left-right', 'Authority to vary deductions', 'Change your monthly share contribution or loan repayment.', 'portal'],
        ['cash-coin', 'Loan application', 'Apply for any loan, add guarantors and see your repayment before you submit.', 'portal'],
        ['person-check', 'Guarantor consent', 'Accept or decline a request to guarantee a member’s loan.', 'portal'],
        ['heart', 'Nominated next of kin', 'Name or change who receives your savings. Changes need two member witnesses.', 'portal'],
        ['box-arrow-right', 'Withdrawal notice', '60 days’ written notice to leave the Society.', 'portal'],
      ]) { %>
        <div class="col-md-6">
          <div class="simple-card d-flex gap-3 align-items-start">
            <i class="bi bi-<%= icon %>" style="font-size: 1.6rem;"></i>
            <div class="flex-grow-1">
              <h3 class="h6 fw-bold mt-1 mb-1"><%= name %></h3>
              <p class="small mb-2"><%= text %></p>
              <% if (where === 'apply') { %>
                <a href="/join/apply" class="small fw-semibold">Apply online →</a> <span class="small text-muted">or collect from the office</span>
              <% } else if (where === 'portal') { %>
                <a href="/portal/login" class="small fw-semibold">Do it online in the member portal →</a>
              <% } else { %>
                <span class="small fw-semibold" style="color: var(--brand);">Collect from the office</span>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container" style="max-width: 960px;">
    <div class="row g-4">
      <div class="col-md-6">
        <div class="simple-card">
          <i class="bi bi-journal-text"></i>
          <h3 class="h5">By-laws</h3>
          <p>The Society’s registered by-laws set out the rules on membership, savings, loans and guarantors. Members can get a copy from the office.</p>
          <a href="/faqs" class="small fw-semibold d-inline-block mt-2">Read the main rules in our FAQs →</a>
        </div>
      </div>
      <div class="col-md-6">
        <div class="simple-card">
          <i class="bi bi-calendar-event"></i>
          <h3 class="h5">Annual General Meeting</h3>
          <p>Held within four months of the end of each financial year (January to December). Members receive at least 15 days’ notice.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
