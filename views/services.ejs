<%- include('partials/header', { pageTitle: 'Services & Products' }) %>

<%- include('partials/page-hero', { image: '/img/service.avif', heading: 'Our Products & Services', lead: 'Savings accounts and loans designed around members’ real needs.' }) %>

<!-- SAVINGS -->
<section class="section">
  <div class="container">
    <div class="text-center">
      <h2>Savings</h2>
      <p class="intro">Every member holds share capital and saves monthly deposits. Your deposits are what you borrow against.</p>
    </div>
    <div class="row g-4">
      <% for (const [icon, name, text] of [
        ['shield-check', 'Share capital', 'KES 6,500 (325 shares of KES 20). It stays with the SACCO while you are a member and earns a dividend set at the AGM.'],
        ['wallet2', 'Normal deposits', 'Your monthly savings, by payroll, M-Pesa or standing order. They earn interest each year and decide how much you can borrow.'],
        ['sun', 'Holiday savings', 'Put money aside through the year for the festive season or a family trip.'],
        ['house-heart', 'Family savings', 'Save towards family goals like school, a home or a wedding.'],
      ]) { %>
        <div class="col-md-6 col-lg-3 fade-in">
          <div class="simple-card">
            <i class="bi bi-<%= icon %>"></i>
            <h3 class="h5"><%= name %></h3>
            <p><%= text %></p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- LOANS -->
<section class="section section-alt">
  <div class="container">
    <div class="text-center">
      <h2>Loans</h2>
      <p class="intro">Members can borrow after six months of saving. Loans are secured by your deposits and, above that, by guarantors who are fellow members.</p>
    </div>
    <div class="row g-4">
      <% for (const [name, text, facts] of [
        ['Normal / Development Loan', 'For land, building, a business or other investment.', ['Up to 3× your deposits', 'Repay over up to 6 years']],
        ['Emergency Loan', 'For hospital bills, funerals or court fines (not rent).', ['Fast-tracked', 'Repay within 12 months']],
        ['School Fees Loan', 'Fees are paid straight to the school.', ['One per calendar year', 'Repay within 12 months']],
        ['Top-Up Loan', 'Add to an existing loan when your needs change.', ['Treated as a new application', 'Clears your old balance first']],
        ['Vacation Loan', 'Plan a holiday or family trip.', []],
        ['Salary Advance', 'A short-term advance against your coming salary.', []],
      ]) { %>
        <div class="col-md-6 col-lg-4 fade-in">
          <div class="simple-card">
            <h3 class="h5 mt-0"><%= name %></h3>
            <p class="<%= facts.length ? 'mb-3' : '' %>"><%= text %></p>
            <% if (facts.length) { %><ul>
              <% for (const f of facts) { %><li><%= f %></li><% } %>
            </ul><% } %>
          </div>
        </div>
      <% } %>
    </div>

    <div class="row g-4 mt-2">
      <div class="col-lg-6 fade-in">
        <div class="simple-card">
          <h3 class="h5 mt-0"><i class="bi bi-calculator fs-5 me-1"></i> How much can I borrow?</h3>
          <ul>
            <li>Up to <span class="fact">3 times your deposits</span>, less anything you still owe.</li>
            <li>Your loan repayments and savings together can’t take more than <span class="fact">two-thirds of your basic pay</span>.</li>
            <li>Members see their exact limit for each loan in the <a href="/portal/login">member portal</a>.</li>
          </ul>
        </div>
      </div>
      <div class="col-lg-6 fade-in">
        <div class="simple-card">
          <h3 class="h5 mt-0"><i class="bi bi-people fs-5 me-1"></i> Guarantors</h3>
          <ul>
            <li>Needed only for the part of the loan above your own deposits.</li>
            <li>Guarantors must be members, and each can guarantee <span class="fact">up to 3 loans</span>.</li>
            <li>Guarantors are told if a repayment is missed.</li>
          </ul>
        </div>
      </div>
    </div>
    <p class="text-center text-muted small mt-4 mb-0">For current interest rates, contact the office or sign in to the member portal.</p>
  </div>
</section>

<!-- NEXT STEPS -->
<section class="section text-center">
  <div class="container">
    <h2 class="h3">Have a question?</h2>
    <p class="intro mb-4">Most answers are in our FAQs. Forms are on the resources page.</p>
    <div class="d-flex flex-wrap gap-2 justify-content-center">
      <a href="/faqs" class="btn btn-primary">Read the FAQs</a>
      <a href="/resources" class="btn btn-outline-primary">Forms & resources</a>
      <a href="/join" class="btn btn-outline-primary">How to join</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
