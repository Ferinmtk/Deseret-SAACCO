<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= formTitle %> · Deseret SACCO</title>
<%- include('../partials/icons') %>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  /* Printable A4 forms that match the SACCO's paper forms. */
  @page { size: A4; margin: 14mm 14mm 16mm; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #e9edf2; color: #0a2030; font: 10.5pt/1.45 'Inter', 'Segoe UI', sans-serif; }
  .sheet { background: #fff; width: 210mm; min-height: 297mm; margin: 12px auto; padding: 14mm; }
  .bar { position: sticky; top: 0; background: #0a2030; color: #fff; padding: 10px 16px; display: flex; gap: 12px; align-items: center; justify-content: center; font-size: 14px; }
  .bar button, .bar a { background: #c68d3e; color: #0a2030; border: 0; border-radius: 6px; padding: 7px 14px; font: 600 14px 'Inter', sans-serif; cursor: pointer; text-decoration: none; }
  .bar a.ghost { background: transparent; color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,.6); }
  header { display: flex; align-items: center; gap: 12px; border-bottom: 2px solid #0a2030; padding-bottom: 8px; margin-bottom: 10px; }
  header img { width: 58px; height: 48px; }
  header .org { font: 700 17pt/1 'Poppins', sans-serif; letter-spacing: .02em; }
  header .addr { font-size: 8.5pt; color: #3a4653; margin-top: 3px; }
  h1 { font: 700 13.5pt 'Poppins', sans-serif; margin: 10px 0 2px; text-transform: uppercase; letter-spacing: .03em; }
  h2 { font: 700 10.5pt 'Poppins', sans-serif; margin: 14px 0 6px; padding: 4px 8px; background: #0a2030; color: #fff; text-transform: uppercase; letter-spacing: .04em; }
  .note { font-size: 9pt; color: #3a4653; margin: 2px 0 8px; }
  .grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 7px 12px; }
  .f { display: flex; flex-direction: column; }
  .f label { font-size: 8pt; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; color: #3a4653; }
  .f .line { border-bottom: 1px solid #0a2030; height: 22px; }
  .f .box { border: 1px solid #0a2030; height: 40px; }
  .s1 { grid-column: span 1; } .s2 { grid-column: span 2; } .s3 { grid-column: span 3; } .s4 { grid-column: span 4; } .s6 { grid-column: span 6; }
  .checks { display: flex; gap: 18px; flex-wrap: wrap; font-size: 9.5pt; padding-top: 4px; }
  .checks span::before { content: ''; display: inline-block; width: 11px; height: 11px; border: 1px solid #0a2030; margin-right: 5px; vertical-align: -1px; }
  .decl { font-size: 9.5pt; margin: 6px 0; }
  .office { border: 1.5px dashed #3a4653; padding: 4px 10px 10px; margin-top: 12px; }
  .office h2 { background: none; color: #0a2030; padding: 4px 0; margin-top: 6px; }
  .pay { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; font-size: 9.5pt; border: 1px solid #c3ccd6; padding: 8px 10px; border-radius: 4px; }
  .pay b { font-size: 10.5pt; }
  .keep { break-inside: avoid; page-break-inside: avoid; }
  h2 { break-after: avoid; }
  footer { margin-top: 12px; font-size: 8pt; color: #5e6b78; border-top: 1px solid #c3ccd6; padding-top: 6px; display: flex; justify-content: space-between; }
  @media screen and (max-width: 820px) { .sheet { width: auto; min-height: 0; margin: 0; padding: 16px; } .grid { grid-template-columns: repeat(2, 1fr); } .s1, .s2, .s3 { grid-column: span 1; } .s4, .s6 { grid-column: span 2; } .pay { grid-template-columns: 1fr; } }
  @media print { body { background: #fff; } .bar { display: none; } .sheet { margin: 0; padding: 0; width: auto; min-height: 0; } h2 { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
</style>
</head>
<body>
<div class="bar"><span><%= formTitle %></span><button onclick="print()">Print or save as PDF</button><a class="ghost" href="/resources">Back to forms</a></div>
<div class="sheet">
<header>
  <img src="/img/brand/logo-mark.svg" alt="">
  <div><div class="org">DESERET SACCO SOCIETY LTD</div>
  <div class="addr"><%= S.SACCO.postal %> · <%= S.SACCO.office %> · <%= S.SACCO.phone %> · <%= S.SACCO.emails[0] %></div></div>
</header>
