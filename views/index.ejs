            <div class="tx-list">
              <div class="tx-head">Recent</div>
              <div class="tx tx-new"><div>M-Pesa deposit<small>UJK4X8B2QP · just now</small></div><span>+5,000</span></div>
              <div class="tx"><div>Check-off · October<small>Payroll deduction</small></div><span>+12,000</span></div>
              <div class="tx"><div>Check-off · September<small>Payroll deduction</small></div><span>+12,000</span></div>
