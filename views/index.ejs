          <a href="/join/apply" class="btn btn-gold btn-lg">Become a member</a>
          <a href="/portal/login" class="btn btn-outline-light btn-lg">Member login</a>
        </div>
        <div class="home-trust"><span><b>Paybill <%= S.SACCO.paybill %></b></span><span>Owned by members</span><span>One member, one vote</span></div>
      </div>
      <div class="col-lg-6">
        <div class="phone" aria-hidden="true">
