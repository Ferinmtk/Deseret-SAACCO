<!-- SAVINGS CALCULATOR -->
<section class="section section-alt">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">
      <div class="col-lg-5 text-center text-lg-start">
        <h2>See what saving does in a year</h2>
        <p class="intro mx-0">Choose how much to save each month. After six months you can borrow up to three times what you’ve saved.</p>
        <a href="/join/apply" class="btn btn-primary">Start saving</a>
      </div>
      <div class="col-lg-7">
        <div class="calc" id="calc">
          <label class="calc-q" for="calcRange">If I save every month</label>
          <div class="calc-amt"><output id="calcAmt">KES 5,000</output> <small>/ month</small></div>
          <input type="range" id="calcRange" min="1000" max="30000" step="500" value="5000">
          <div class="calc-scale"><span>KES 1,000</span><span>KES 30,000</span></div>
          <div class="calc-bars" aria-hidden="true"><% for (let i = 0; i < 12; i++) { %><i></i><% } %></div>
          <div class="calc-months" aria-hidden="true"><span>Month 1</span><span>Month 6 · loans open</span><span>Month 12</span></div>
          <div class="calc-outs" aria-live="polite">
            <div class="calc-out"><span>Deposits after a year</span><b id="calcDep">KES 60,000</b></div>
            <div class="calc-out calc-gold"><span>You could borrow</span><b id="calcLim">KES 180,000</b></div>
          </div>
          <p class="calc-fine">Before interest. Loans also depend on your pay: repayments and savings can’t take more than two-thirds of basic pay.</p>
        </div>
      </div>
    </div>
  </div>
</section>

