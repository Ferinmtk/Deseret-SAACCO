<%- include('partials/header') %>

<!-- HERO: the family photo, with a phone showing a member paying by M-Pesa.
     Her deposits and loan limit rise; it loops while the phone is on screen. -->
<section class="hero text-white pay-scene" data-lands-at="4600" data-loop-ms="10000">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">
      <div class="col-lg-7 text-center text-lg-start">
        <p class="hero-eyebrow">Deseret SACCO Society Ltd · Since 2006</p>
        <h1 class="display-3 fw-bold">Save, borrow and grow together</h1>
        <p class="lead">The savings and credit co-operative for employees of The Church of Jesus Christ of Latter-day Saints in Kenya and their families.</p>
        <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-lg-start mt-3">
          <a href="/join/apply" class="btn btn-gold btn-lg">Join Us</a>
          <a href="/portal/login" class="btn btn-outline-light btn-lg">Member login</a>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="phone" data-scene-card aria-hidden="true">
          <div class="phone-screen">
            <div class="phone-punch"></div>
            <div class="phone-status"><span>9:15</span><span>Safaricom · 4G <i class="bi bi-reception-4"></i></span></div>
            <div class="phone-appbar">
              <div class="phone-brand"><img src="/img/brand/logo-mark-reverse.svg" alt="">DESERET SACCO</div>
              <div class="phone-label">Deposits</div>
              <div class="phone-bal" data-count-from="245000" data-count-to="250000">KES 245,000</div>
              <div class="phone-sub">Grace Wanjiru · DS0001</div>
            </div>
            <div class="phone-limit"><div>You can borrow up to<b data-count-from="735000" data-count-to="750000" data-count-delay="950">KES 735,000</b></div><span>3× deposits</span></div>
            <div class="tx-list">
              <div class="tx-head">Recent</div>
              <div class="tx tx-new"><div>M-Pesa deposit<small>UJK4X8B2QP · just now</small></div><span>+5,000</span></div>
              <div class="tx"><div>Check-off · October<small>Payroll deduction</small></div><span>+12,000</span></div>
              <div class="tx"><div>Check-off · September<small>Payroll deduction</small></div><span>+12,000</span></div>
            </div>
            <div class="stk-scrim"></div>
            <div class="stk">
              <div class="stk-app">M-PESA</div>
              <p>Do you want to pay Ksh5,000.00 to DESERET SACCO for account DS0001? Enter M-PESA PIN</p>
              <div class="stk-pin"><i></i><i></i><i></i><i></i></div>
              <div class="stk-acts"><span>CANCEL</span><span class="stk-ok">OK</span></div>
            </div>
            <div class="sms">
              <div class="sms-from">MPESA<span>now</span></div>
              <p>UJK4X8B2QP Confirmed. Ksh5,000.00 sent to DESERET SACCO for account DS0001 on 20/10/26 at 9:15 AM New M-PESA balance is Ksh12,430.50. Transaction cost, Ksh0.00.</p>
            </div>
          </div>
        </div>
        <p class="phone-note">Sample member. Pay <b>Ksh 5,000</b> and your loan limit goes up by <b>Ksh 15,000</b>.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE OFFER -->
<section class="section text-center">
  <div class="container">
    <h2>What membership gives you</h2>
    <p class="intro">Everything a member needs, run by members for members.</p>
    <div class="row g-4 text-start">
      <div class="col-md-4 fade-in">
        <div class="simple-card">
          <i class="bi bi-piggy-bank"></i>
          <h3 class="h5">Save</h3>
          <p>Build your deposits every month through payroll, M-Pesa or a standing order. Deposits earn interest and your shares earn a dividend each year.</p>
        </div>
      </div>
      <div class="col-md-4 fade-in">
        <div class="simple-card">
          <i class="bi bi-cash-coin"></i>
          <h3 class="h5">Borrow</h3>
          <p>After six months of saving, borrow up to three times your deposits — for school fees, emergencies, building or a family holiday.</p>
        </div>
      </div>
      <div class="col-md-4 fade-in">
        <div class="simple-card">
          <i class="bi bi-people"></i>
          <h3 class="h5">Belong</h3>
          <p>Owned and run by members. One member, one vote at the AGM, and an elected board and supervisory committee.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- HOW TO JOIN -->
<section class="section section-alt text-center">
  <div class="container">
    <h2>Joining takes three steps</h2>
    <p class="intro">Open to employees of the Church and their families. <a href="/join">See who can join</a>.</p>
    <div class="row g-4">
      <div class="col-md-4 fade-in">
        <div class="step-num">1</div>
        <h3 class="h6 fw-bold">Apply online</h3>
        <p class="text-muted mb-0">Fill in the <a href="/join/apply">membership application</a>, then bring a copy of your ID and your employer’s introduction letter.</p>
      </div>
      <div class="col-md-4 fade-in">
        <div class="step-num">2</div>
        <h3 class="h6 fw-bold">Pay the entrance fee and shares</h3>
        <p class="text-muted mb-0">KES 1,000 entrance fee and KES 6,500 share capital (325 shares of KES 20).</p>
      </div>
      <div class="col-md-4 fade-in">
        <div class="step-num">3</div>
        <h3 class="h6 fw-bold">Get your member number</h3>
        <p class="text-muted mb-0">Once the committee approves you, you can sign in to the member portal.</p>
      </div>
    </div>
    <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
      <a href="/join/apply" class="btn btn-primary">Apply online</a>
      <a href="/join" class="btn btn-outline-primary">How to join</a>
    </div>
  </div>
</section>

<!-- ALREADY A MEMBER -->
<section class="section">
  <div class="container">
    <div class="pay-box">
      <div class="row g-4 align-items-center">
        <div class="col-lg-5">
          <h2 class="h3 fw-bold text-white mb-2">Already a member?</h2>
          <p class="mb-3" style="color: #cdd6df;">Check your balances, apply for a loan, accept guarantor requests and download statements in the member portal.</p>
          <a href="/portal/login" class="btn btn-light fw-semibold" style="color: var(--brand);">Sign in to the portal</a>
        </div>
        <div class="col-6 col-lg-3 offset-lg-1">
          <div class="label">M-Pesa Paybill</div>
          <div class="value"><%= S.SACCO.paybill %></div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="label">Account number</div>
          <div class="value"><%= S.SACCO.account %></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/js/demos.js" defer></script>

<%- include('partials/footer') %>
