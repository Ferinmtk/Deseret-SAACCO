        <div class="stmt-stack" aria-hidden="true">
          <div class="stmt-toast"><span class="bi bi-check-lg"></span><div><b>Faith Muthoni accepted</b> your guarantor request for the School Fees Loan.<small>Sent to the credit officer · 2 of 2 guarantors</small></div></div>
          <div class="stmt">
            <div class="stmt-top"><span class="stmt-who"><span class="stmt-av">GW</span>Grace’s deposits</span><span>Oct 2026</span></div>
            <div class="stmt-big"><span data-count-from="245000" data-count-to="250000" data-count-delay="900">KES 245,000</span><small>Backs her loans · earns interest</small></div>
            <div class="tx-list">
              <div class="tx tx-new"><div>M-Pesa · Paybill <%= S.SACCO.paybill %><small>UJK4X8B2QP · just now</small></div><span>+5,000</span></div>
              <div class="tx"><div>Check-off · October<small>Payroll deduction</small></div><span>+12,000</span></div>
              <div class="tx"><div>Check-off · September<small>Payroll deduction</small></div><span>+12,000</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(() => {
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const kes = n => 'KES ' + n.toLocaleString('en-KE');

  // Count a number up, easing out, over about a second.
  const countUp = (el, from, to) => {
    const start = performance.now();
    const step = t => {
      const p = Math.min((t - start) / 1100, 1);
      el.textContent = kes(Math.round(from + (to - from) * (1 - Math.pow(1 - p, 3))));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  // The CSS plays the sequence; JS starts it and runs the number count-ups.
  // landsAt is when (ms) the deposit lands, so the counts start just after it.
  const play = (scene, landsAt) => {
    const counters = scene.querySelectorAll('[data-count-from]');
    (scene._timers || []).forEach(clearTimeout);
    scene._timers = [];
    scene.classList.remove('play', 'done');
    counters.forEach(el => { el.textContent = kes(+el.dataset.countFrom); });
    if (reduced) {
      scene.classList.add('done');
      counters.forEach(el => { el.textContent = kes(+el.dataset.countTo); });
      return;
    }
    void scene.offsetWidth; // restart the CSS animations
    scene.classList.add('play');
    counters.forEach(el => scene._timers.push(setTimeout(
      () => countUp(el, +el.dataset.countFrom, +el.dataset.countTo),
      landsAt + 150 + (+el.dataset.countDelay || 0))));
  };

  // Start each scene once its card is mostly on screen (on phones the handset is below the fold).
  const playWhenSeen = (scene, card, landsAt) => {
    const seen = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) { play(scene, landsAt); seen.disconnect(); }
    }, { threshold: 0.6 });
    seen.observe(card);
  };
  playWhenSeen(document.getElementById('payDemo'), document.querySelector('.phone'), 4600);
  playWhenSeen(document.getElementById('stmtDemo'), document.querySelector('.stmt'), 1100);

  document.querySelectorAll('[data-replay]').forEach(btn =>
    btn.addEventListener('click', () => play(document.getElementById(btn.dataset.replay), 4600)));

  // Savings calculator: deposits after 12 months and the 3× loan limit.
  const range = document.getElementById('calcRange');
  const bars = document.querySelectorAll('.calc-bars i');
  const update = () => {
    const m = +range.value, min = +range.min, max = +range.max;
    range.style.setProperty('--p', ((m - min) / (max - min) * 100) + '%');
    document.getElementById('calcAmt').textContent = kes(m);
    document.getElementById('calcDep').textContent = kes(m * 12);
    document.getElementById('calcLim').textContent = kes(m * 36);
    // Bars keep their shape (month 1 to 12) and grow taller with the amount saved.
    const scale = 0.35 + 0.65 * (m - min) / (max - min);
    bars.forEach((b, i) => { b.style.height = ((i + 1) / 12 * 100 * scale) + '%'; });
  };
  range.addEventListener('input', update);
  update();
})();
</script>

