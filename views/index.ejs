<%- include('partials/header') %>

<!-- HERO SECTION -->
<section class="hero d-flex align-items-center text-white text-center">
  <div class="container">
    <p class="hero-eyebrow">Deseret SACCO Society Ltd · Since 2006</p>
    <h1 class="display-3 fw-bold">Save, borrow and grow together</h1>
    <p class="lead">The savings and credit co-operative for employees of The Church of Jesus Christ of Latter-day Saints in Kenya and their families.</p>
    <div class="d-flex flex-wrap gap-2 justify-content-center mt-3">
      <a href="/join/apply" class="btn btn-gold btn-lg">Join Us</a>
      <a href="/portal/login" class="btn btn-outline-light btn-lg">Member login</a>
    </div>
  </div>
</section>

<!-- WHAT WE OFFER -->
<section class="section text-center">
  <div class="container">
    <h2>What membership gives you</h2>
    <p class="intro">Everything a member needs, run by members for members.</p>
    <div class="row g-4 text-start">
      <div class="col-md-4 fade-in">
        <div class="simple-card">
          <i class="bi bi-piggy-bank"></i>
          <h3 class="h5">Save</h3>
          <p>Build your deposits every month through payroll, M-Pesa or a standing order. Deposits earn interest and your shares earn a dividend each year.</p>
        </div>
      </div>
      <div class="col-md-4 fade-in">
        <div class="simple-card">
          <i class="bi bi-cash-coin"></i>
          <h3 class="h5">Borrow</h3>
          <p>After six months of saving, borrow up to three times your deposits — for school fees, emergencies, building or a family holiday.</p>
        </div>
      </div>
      <div class="col-md-4 fade-in">
        <div class="simple-card">
          <i class="bi bi-people"></i>
          <h3 class="h5">Belong</h3>
          <p>Owned and run by members. One member, one vote at the AGM, and an elected board and supervisory committee.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- HOW TO JOIN -->
<section class="section section-alt text-center">
  <div class="container">
    <h2>Joining takes three steps</h2>
    <p class="intro">Open to employees of the Church and their families. <a href="/join">See who can join</a>.</p>
    <div class="row g-4">
      <div class="col-md-4 fade-in">
        <div class="step-num">1</div>
        <h3 class="h6 fw-bold">Apply online</h3>
        <p class="text-muted mb-0">Fill in the <a href="/join/apply">membership application</a>, then bring a copy of your ID and your employer’s introduction letter.</p>
      </div>
      <div class="col-md-4 fade-in">
        <div class="step-num">2</div>
        <h3 class="h6 fw-bold">Pay the entrance fee and shares</h3>
        <p class="text-muted mb-0">KES 1,000 entrance fee and KES 6,500 share capital (325 shares of KES 20).</p>
      </div>
      <div class="col-md-4 fade-in">
        <div class="step-num">3</div>
        <h3 class="h6 fw-bold">Get your member number</h3>
        <p class="text-muted mb-0">Once the committee approves you, you can sign in to the member portal.</p>
      </div>
    </div>
    <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
      <a href="/join/apply" class="btn btn-primary">Apply online</a>
      <a href="/join" class="btn btn-outline-primary">How to join</a>
    </div>
  </div>
</section>

<!-- ALREADY A MEMBER -->
<section class="section">
  <div class="container">
    <div class="pay-box">
      <div class="row g-4 align-items-center">
        <div class="col-lg-5">
          <h2 class="h3 fw-bold text-white mb-2">Already a member?</h2>
          <p class="mb-3" style="color: #cdd6df;">Check your balances, apply for a loan, accept guarantor requests and download statements in the member portal.</p>
          <a href="/portal/login" class="btn btn-light fw-semibold" style="color: var(--brand);">Sign in to the portal</a>
        </div>
        <div class="col-6 col-lg-3 offset-lg-1">
          <div class="label">M-Pesa Paybill</div>
          <div class="value"><%= S.SACCO.paybill %></div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="label">Account number</div>
          <div class="value"><%= S.SACCO.account %></div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
