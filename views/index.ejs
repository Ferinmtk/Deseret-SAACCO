            <div class="phone-punch"></div>
            <div class="phone-status"><span>9:15</span><span>Safaricom · 4G <i class="bi bi-reception-4"></i></span></div>
            <div class="phone-appbar">
              <div class="phone-brand"><img src="/img/brand/logo-mark-reverse.svg" alt="">DESERET SACCO</div>
