<%- include('partials/header', { pageTitle: 'About Us' }) %>

<%- include('partials/page-hero', { photo: 'about', focus: 'center 30%', heading: 'About Deseret SACCO', lead: 'Empowering members through savings, credit and co-operative values since 2006.' }) %>

<section class="about-section py-5">
  <div class="container">

    <!-- Who We Are -->
    <div class="row align-items-center mb-5" data-aos="fade-up">
      <div class="col-md-6">
        <h2 class="fw-bold">Who We Are</h2>
        <p>Deseret SACCO is a Savings and Credit Co-operative Society registered in 2006 under the Co-operative Societies Act of the Laws of Kenya. The Sacco primarily mobilizes savings and deposits and extends credit to its members, thereby empowering them economically and socially.</p>
        <p>We are guided by co-operative values, visionary leadership, and a commitment to transparency, democracy, and sustainable socio-economic empowerment.</p>
        <ul>
          <li><strong>Office:</strong> <%= S.SACCO.office %></li>
        </ul>
      </div>
      <div class="col-md-6 text-center" data-aos="zoom-in">
        <img src="/img/hero/family-960.jpg" alt="A young family sitting together on a park bench" class="img-fluid rounded" loading="lazy">
      </div>
    </div>

    <!-- History -->
    <div class="row mb-5" data-aos="fade-up">
      <div class="col">
        <h2 class="fw-bold">Our History</h2>
        <p>Deseret SACCO was registered in 2006 by employees of The Church of Jesus Christ of Latter-day Saints in Kenya who wanted a safe, affordable way to save together and borrow from one another. It has grown steadily since, guided by elected leaders, dedicated staff and committed members.</p>
        <p>Over the years we have added products as members’ needs changed: holiday and family savings, school fees and emergency loans, and development loans for land, homes and businesses. Today members can also apply, pay and follow their accounts online.</p>
      </div>
    </div>

    <!-- Mission, Vision, Values -->
    <div class="row mb-5" data-aos="fade-up">
      <div class="col-md-4">
        <h3 class="fw-bold">Mission</h3>
        <p>To be the leading provider of financial solutions and exceptional customer experience to our members.</p>
      </div>
      <div class="col-md-4">
        <h3 class="fw-bold">Vision</h3>
        <p>A leading Sacco in sustainable socio-economic empowerment.</p>
      </div>
      <div class="col-md-4">
        <h3 class="fw-bold">Core Values</h3>
        <ul>
          <li>Customer-focused</li>
          <li>Teamwork</li>
          <li>Integrity</li>
        </ul>
      </div>
    </div>

    <!-- Objectives -->
    <div class="row mb-5" data-aos="fade-up">
      <div class="col-md-6">
        <h3 class="fw-bold">Our Objectives</h3>
        <ul>
          <li>Receive deposits and advance loans to our members.</li>
          <li>Promote economic and social development through affordable credit.</li>
          <li>Continuously educate members on co-operative and economic development.</li>
        </ul>
      </div>
      <div class="col-md-6" data-aos="fade-left">
        <h3 class="fw-bold">Who is a Member in Good Standing?</h3>
        <ul>
          <li>Is current with loan repayments and monthly contributions.</li>
          <li>Has not acted in a way that damages the Society's interests.</li>
          <li>Complies fully with the Society's policies and rules.</li>
        </ul>
      </div>
    </div>

    <!-- Membership -->
    <div class="row mb-5" data-aos="fade-up">
      <div class="col-md-6">
        <h3 class="fw-bold">Membership</h3>
        <ul>
          <li>Open to residents of Kenya aged 18 and above.</li>
          <li>Must not be a member of another SACCO at the same time.</li>
          <li>No prior convictions for fraud or dishonesty.</li>
          <li>Common bond includes employees and spouses of The Church of Jesus Christ of Latter-day Saints and its subsidiaries.</li>
        </ul>
      </div>
      <div class="col-md-6">
        <h3 class="fw-bold">Membership Requirements</h3>
        <ul>
          <li>Entrance fee: <strong>Ksh. 1,000</strong></li>
          <li>Minimum shares: <strong>325 shares</strong> at <strong>Ksh. 20</strong> each</li>
          <li>Total minimum share capital: <strong>Ksh. 6,500</strong></li>
          <li>Duly filled Application Form</li>
        </ul>
      </div>
    </div>

    <!-- Co-operative Principles -->
    <div class="row mb-5" data-aos="fade-up">
      <div class="col">
        <h2 class="fw-bold text-center mb-4">Our Co-operative Principles</h2>
        <div class="row g-3 text-center">
          <% for (const [icon, name] of [['person-check', 'Voluntary & Open Membership'], ['people', 'Democratic Member Control'], ['shield-lock', 'Autonomy & Independence'],
                                          ['cash-coin', 'Economic Participation'], ['mortarboard', 'Education & Training'], ['house-heart', 'Co-operation & Community Concern']]) { %>
            <div class="col-6 col-md-4"><div class="simple-card"><i class="bi bi-<%= icon %>"></i><h3 class="h6 fw-bold mt-2 mb-0"><%= name %></h3></div></div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Board of Directors -->
    <div class="row mb-5" data-aos="fade-up">
      <div class="col">
        <h2 class="fw-bold text-center mb-4">Board of Directors</h2>
        <div class="row g-3 text-center justify-content-center">
          <% const board = [
            {name: "James M. Kyulu", role: "Chairman", img: "/img/board/placeholder-m.jpg"},
            {name: "Daniel M. Muthiani", role: "Vice Chairperson", img: "/img/board/placeholder-m.jpg"},
            {name: "Millicent A. Suchi", role: "Hon-Secretary", img: "/img/board/placeholder-f.jpg"},
            {name: "CPA Charles N. Gesimba", role: "Treasurer", img: "/img/board/charles-gesimba.jpg", photo: true},
            {name: "Francis Kioko Mutua", role: "Board Member", img: "/img/board/placeholder-m.jpg"},
            {name: "CPA Maurice B. Nyagwoka", role: "Board Member", img: "/img/board/placeholder-m.jpg"},
            {name: "Paul M. Mwetu", role: "Board Member", img: "/img/board/placeholder-m.jpg"},
            {name: "Liza Cheruto Ngimor", role: "Board Member", img: "/img/board/placeholder-f.jpg"},
            {name: "CPA Salim B. Mariita", role: "Board Member", img: "/img/board/salim-mariita.jpg", photo: true},
          ]; %>

          <% board.forEach(member => { %>
            <div class="col-6 col-md-4 col-lg-3">
              <div class="member-card">
                <img src="<%= member.img %>" alt="<%= member.photo ? member.name : 'Photo coming soon' %>" class="member-img" loading="lazy">
                <h3 class="member-name"><%= member.name %></h3>
                <p class="member-role"><%= member.role %></p>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Supervisory Committee -->
    <div class="row mb-5" data-aos="fade-up">
      <div class="col">
        <h2 class="fw-bold text-center mb-4">Supervisory Committee</h2>
        <div class="row g-3 text-center justify-content-center">
          <% const committee = [
            {name: "Fredrick Shamola Bulemi", role: "Chairperson", img: "/img/board/placeholder-m.jpg"},
            {name: "CPA Catherine Nthenya John", role: "Secretary", img: "/img/board/placeholder-f.jpg"},
            {name: "CPA Salim B. Mariita", role: "Member", img: "/img/board/salim-mariita.jpg", photo: true},
          ]; %>

          <% committee.forEach(member => { %>
            <div class="col-6 col-md-4">
              <div class="member-card">
                <img src="<%= member.img %>" alt="<%= member.photo ? member.name : 'Photo coming soon' %>" class="member-img" loading="lazy">
                <h3 class="member-name"><%= member.name %></h3>
                <p class="member-role"><%= member.role %></p>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center" data-aos="zoom-in">
      <a href="/join" class="btn btn-success btn-lg px-5">Become a Member</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
