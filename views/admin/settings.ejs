<%- include('../partials/app-top', { area: 'admin' }) %>
<% const ro = !can.settings; %>
<div class="demo-note mb-3"><i class="bi bi-info-circle"></i> These are <strong>sample values</strong> until checked against the by-laws and the SACCO’s loan policy. Changes apply to new applications only and are written to the audit trail.</div>
<form method="POST" action="/admin/settings">
  <fieldset <%= ro ? 'disabled' : '' %>>
  <div class="card mb-3">
    <div class="card-header"><i class="bi bi-cash-stack"></i> Loan products</div>
    <div class="table-responsive"><table class="table align-middle">
      <thead><tr><th>Product</th><th>Interest %/month</th><th>Method</th><th>Max months</th><th>× deposits</th><th>Guarantors</th><th>Fee %</th></tr></thead>
      <tbody><% for (const p of products) { %>
        <tr><td class="fw-semibold"><%= p.name %><%= p.max_salary_pct ? ` (max ${p.max_salary_pct}% of pay)` : '' %></td>
          <td><input class="form-control form-control-sm" style="width:90px" type="number" step="0.01" name="p_<%= p.code %>_rate" value="<%= +(p.rate_monthly * 100).toFixed(2) %>"></td>
          <td class="small"><%= p.method %></td>
          <td><input class="form-control form-control-sm" style="width:80px" type="number" name="p_<%= p.code %>_months" value="<%= p.max_months %>"></td>
          <td><input class="form-control form-control-sm" style="width:80px" type="number" step="0.5" name="p_<%= p.code %>_multiplier" value="<%= p.multiplier %>"></td>
          <td><input class="form-control form-control-sm" style="width:70px" type="number" name="p_<%= p.code %>_guarantors" value="<%= p.min_guarantors %>"></td>
          <td><input class="form-control form-control-sm" style="width:80px" type="number" step="0.1" name="p_<%= p.code %>_fee" value="<%= p.fee_pct %>"></td></tr>
      <% } %></tbody>
    </table></div>
  </div>
  <div class="card mb-3">
    <div class="card-header"><i class="bi bi-sliders"></i> Membership & lending rules</div>
    <div class="card-body row g-3">
      <% for (const s of settings) { %>
        <div class="col-md-6 col-xl-4"><label class="form-label"><%= s.label %></label><input class="form-control" type="number" step="any" name="s_<%= s.key %>" value="<%= s.value %>"></div>
      <% } %>
    </div>
  </div>
  <% if (!ro) { %><button class="btn btn-primary mb-4">Save changes</button><% } %>
  </fieldset>
</form>
<div class="card" id="staff">
  <div class="card-header"><i class="bi bi-person-badge"></i> Staff & leadership logins</div>
  <div class="card-body small text-muted border-bottom">A login belongs to the office, not the person. When someone leaves office, switch off their login and add one for whoever takes over. Their member account stays as it is.</div>
  <div class="table-responsive"><table class="table align-middle">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Last sign-in</th><th></th></tr></thead>
    <tbody><% for (const s of staffList) { %>
      <tr class="<%= s.active ? '' : 'text-muted' %>">
        <td><%= s.name %><% if (!s.active) { %> <span class="pill pill-muted">Switched off</span><% } else if (s.must_change_password) { %> <span class="pill pill-warn">Not signed in yet</span><% } %></td>
        <td class="small"><%= s.email %></td><td><%= ROLE_LABELS[s.role] %></td>
        <td class="small"><%= s.last_login ? S.fmtDate(s.last_login) : '—' %></td>
        <td class="text-end"><% if (can.settings && s.id !== staff.id) { %>
          <form method="POST" action="/admin/staff/<%= s.id %>/<%= s.active ? 'off' : 'on' %>" class="d-inline">
            <button class="btn btn-sm <%= s.active ? 'btn-outline-danger' : 'btn-outline-primary' %>" <% if (s.active) { %>onclick="return confirm('Switch off <%= s.name.replace(/'/g, '') %>’s login? They will no longer be able to sign in.')"<% } %>><%= s.active ? 'Switch off' : 'Switch on' %></button>
          </form>
        <% } %></td>
      </tr>
    <% } %></tbody>
  </table></div>
  <% if (can.settings) { %>
    <form method="POST" action="/admin/staff" class="card-body border-top">
      <div class="fw-semibold mb-2">Add a login (for example, a new board member or clerk)</div>
      <div class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label small" for="s-name">Full name</label><input class="form-control" id="s-name" name="name" maxlength="100" required></div>
        <div class="col-md-4"><label class="form-label small" for="s-email">Email</label><input class="form-control" id="s-email" name="email" type="email" maxlength="200" required></div>
        <div class="col-md-2"><label class="form-label small" for="s-role">Role</label><select class="form-select" id="s-role" name="role"><% for (const [key, label] of Object.entries(ROLE_LABELS)) { %><option value="<%= key %>" <%= key === 'board' ? 'selected' : '' %>><%= label %></option><% } %></select></div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Add login</button></div>
      </div>
      <div class="small text-muted mt-2">You’ll see a one-time password to give them in person. They choose their own when they first sign in.</div>
    </form>
  <% } %>
  <div class="card-body small text-muted border-top">Clerk records · Credit Officer appraises · Manager approves · Treasurer disburses · Board views. No one can approve their own entry.</div>
</div>
<%- include('../partials/app-bottom') %>
