<%- include('../partials/app-top', { area: 'admin' }) %>
<% const k = S.fmtKes; const via = S.CHANNELS;
   const part = p => p.account === 'loan' ? 'Loan #' + p.loan_id : S.ACCOUNTS[p.account]; %>
<div class="d-flex flex-wrap gap-2 mb-3">
  <% for (const [s, label] of [['', 'All'], ['pending', 'Awaiting approval'], ['posted', 'Posted'], ['rejected', 'Rejected']]) { %>
    <a href="?status=<%= s %>" class="btn btn-sm <%= status === s ? 'btn-primary' : 'btn-light' %>"><%= label %><%= s === 'pending' && counts.pendingPayments ? ' (' + counts.pendingPayments + ')' : '' %></a>
  <% } %>
  <% if (can.recordPayment) { %><a href="/admin/payments/new" class="btn btn-sm btn-primary ms-auto"><i class="bi bi-plus"></i> Record a payment</a><% } %>
</div>
<div class="card"><div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead><tr><th>Date</th><th>Member</th><th>Channel · Ref</th><th class="text-end">Amount</th><th>Maker → Checker</th><th>Status</th></tr></thead>
    <tbody>
      <% for (const p of rows) { %>
        <tr>
          <td class="text-nowrap small"><%= S.fmtDate(p.created_at) %></td>
          <td><a href="/admin/members/<%= p.member_id %>" class="text-reset"><%= p.name %></a><div class="small text-muted"><%= p.member_no %></div></td>
          <td class="small"><%= via[p.channel] %> · <%= p.reference %><% if (p.split) { %><div class="text-muted"><%= p.split.map(x => part(x) + ' ' + k(x.amount)).join(' · ') %></div><% } %></td>
          <td class="text-end num fw-semibold"><%= k(p.amount) %></td>
          <td class="small"><%= p.maker || 'Member (M-Pesa)' %><%= p.checker ? ' → ' + p.checker : '' %></td>
          <td>
            <% if (p.status === 'pending' && (can.approvePayment || (p.submitted_by_member && staff.role === 'clerk'))) { %>
              <form method="POST" action="/admin/payments/<%= p.id %>/decision" class="d-flex gap-1">
                <button name="decision" value="approve" class="btn btn-sm btn-primary" title="Approve"><i class="bi bi-check-lg"></i></button>
                <button name="decision" value="reject" class="btn btn-sm btn-outline-danger" title="Reject" onclick="this.form.reason.value = prompt('Reason?') || ''; return !!this.form.reason.value"><i class="bi bi-x-lg"></i></button>
                <input type="hidden" name="reason">
              </form>
            <% } else { %><span class="pill pill-<%= { posted: 'ok', pending: 'warn', rejected: 'danger' }[p.status] %>"><%= p.status === 'pending' ? 'Awaiting approval' : p.status %></span><% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div></div>
<%- include('../partials/app-bottom') %>
