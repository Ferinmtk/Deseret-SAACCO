<%- include('../partials/app-top', { area: 'admin' }) %>
<% const k = S.fmtKes; const maxMonth = Math.max(...months.map(m => m.total), 1);
   const queues = [
     { show: can.approveMember, n: counts.pendingMembers, text: 'New members to approve', href: '/admin/approvals', icon: 'person-plus' },
     { show: can.approvePayment, n: counts.pendingPayments, text: 'Payments to verify', href: '/admin/payments?status=pending', icon: 'receipt' },
     { show: !can.approvePayment && staff.role === 'clerk', n: counts.memberCodes, text: 'M-Pesa codes from members to verify', href: '/admin/approvals', icon: 'phone' },
     { show: can.handleRequests, n: counts.requests, text: 'Nominee and deduction requests', href: '/admin/approvals', icon: 'arrow-left-right' },
     { show: can.appraise, n: counts.appraisal, text: 'Loans to appraise', href: '/admin/loans', icon: 'clipboard-check' },
     { show: can.approveLoan, n: counts.recommended, text: 'Loans to approve', href: '/admin/loans', icon: 'check2-square' },
     { show: can.disburse, n: counts.approved, text: 'Loans to disburse', href: '/admin/loans', icon: 'send' },
     { show: true, n: counts.guarantors, text: 'Loans waiting on guarantors', href: '/admin/loans', icon: 'people' },
     { show: can.answerMessages, n: counts.messages, text: 'Messages from the website', href: '/admin/messages', icon: 'envelope' },
   ].filter(q => q.show); %>

<% if (staff.role === 'board') { %><div class="demo-note mb-3"><i class="bi bi-eye"></i> Board / supervisory view: you can see everything but can’t change anything.</div><% } %>

<div class="row g-3 mb-3">
  <div class="col-6 col-xl-3"><div class="card"><div class="stat"><div class="k">Members</div><div class="v num"><%= members %></div><div class="s">+<%= newMembers %> in the last 12 months</div></div></div></div>
  <div class="col-6 col-xl-3"><div class="card"><div class="stat"><div class="k">Deposits</div><div class="v num"><%= k(totals.deposits) %></div><div class="s">Share capital <%= k(totals.shares) %></div></div></div></div>
  <div class="col-6 col-xl-3"><div class="card"><div class="stat"><div class="k">Loan book</div><div class="v num"><%= k(pf.book) %></div><div class="s"><%= pf.loans.length %> active loans</div></div></div></div>
  <div class="col-6 col-xl-3"><a class="stat-link" href="/admin/arrears"><div class="card"><div class="stat"><div class="k">Portfolio at risk (30+ days)</div><div class="v num <%= pf.par30 > 5 ? 'neg' : 'pos' %>"><%= pf.par30.toFixed(1) %>%</div><div class="s">90+ days: <%= pf.par90.toFixed(1) %>% · target under 5%</div></div></div></a></div>
</div>

<div class="row g-3">
  <div class="col-xl-5">
    <div class="card mb-3">
      <div class="card-header"><i class="bi bi-inbox"></i> Work queues</div>
      <div class="card-body p-0">
        <% for (const q of queues) { %>
          <a href="<%= q.href %>" class="d-flex align-items-center gap-3 px-3 py-2 border-bottom text-reset text-decoration-none">
            <i class="bi bi-<%= q.icon %> fs-5 text-muted"></i><span class="flex-grow-1"><%= q.text %></span>
            <span class="pill <%= q.n ? 'pill-warn' : 'pill-muted' %>"><%= q.n %></span>
          </a>
        <% } %>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header"><i class="bi bi-box-arrow-right"></i> Exit notices · refunds due</div>
      <div class="card-body p-0">
        <% for (const m of exiting) { %>
          <a href="/admin/members/<%= m.id %>" class="d-flex justify-content-between px-3 py-2 border-bottom text-reset text-decoration-none">
            <span><%= m.first_name %> <%= m.last_name %> <span class="small text-muted"><%= m.member_no %></span></span>
            <span class="pill <%= m.daysLeft < 15 ? 'pill-danger' : 'pill-warn' %>">Refund by <%= m.refundBy %> (<%= m.daysLeft %>d)</span>
          </a>
        <% } %>
        <% if (!exiting.length) { %><div class="empty py-3">No pending exits.</div><% } %>
      </div>
    </div>

    <% if (staleGuarantees.length) { %>
      <div class="card">
        <div class="card-header"><i class="bi bi-hourglass-split"></i> Guarantor requests waiting 3+ days</div>
        <div class="card-body p-0">
          <% for (const g of staleGuarantees) { %>
            <a href="/admin/loans/<%= g.loan_id %>" class="d-flex justify-content-between px-3 py-2 border-bottom small text-reset text-decoration-none">
              <span><%= g.guarantor %> → for <%= g.borrower %></span><span class="text-muted"><%= S.daysBetween(g.requested_at, S.today()) %> days</span>
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <div class="col-xl-7">
    <div class="card mb-3">
      <div class="card-header"><i class="bi bi-bar-chart"></i> Money received per month</div>
      <div class="card-body">
        <div class="bars">
          <% for (const m of months) { %>
            <div class="bar"><span class="num"><%= Math.round(m.total / 1000) %>k</span><div style="height: <%= Math.round(m.total / maxMonth * 100) %>%"></div><span><%= m.label %></span></div>
          <% } %>
        </div>
        <div class="d-flex flex-wrap gap-3 small text-muted mt-3">
          <% const ct = channels.reduce((s, c) => s + c.total, 0); for (const c of channels) { %>
            <span><strong class="text-dark"><%= Math.round(c.total / ct * 100) %>%</strong> <%= S.CHANNELS[c.channel] %></span>
          <% } %>
          <span class="ms-auto">Last 12 months by channel</span>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><i class="bi bi-activity"></i> Latest activity <a class="ms-auto small" href="/admin/audit">Audit trail</a></div>
      <div class="table-responsive"><table class="table table-sm">
        <tbody>
          <% for (const a of activity) { %>
            <tr><td class="text-nowrap small text-muted"><%= S.fmtDate(a.created_at) %></td><td class="small"><strong><%= a.actor %></strong> · <%= a.action %><span class="text-muted"><%= a.details ? ': ' + a.details : '' %></span></td></tr>
          <% } %>
        </tbody>
      </table></div>
    </div>
  </div>
</div>
<%- include('../partials/app-bottom') %>
